{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/analyze.js": {
      "maxDuration": 60,
      "includeFiles": "data/**"
    },
    "api/cases/[id]/index.js": {
      "maxDuration": 60,
      "includeFiles": "data/**"
    },
    "api/cases/[id]/flow.js": {
      "maxDuration": 60,
      "includeFiles": "data/**"
    },
    "api/cases/[id]/skills-tree.js": {
      "maxDuration": 60,
      "includeFiles": "data/**"
    },
    "api/**/*.js": {
      "maxDuration": 30,
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    { "source": "/skill-map", "destination": "/skill-map.html" },
    { "source": "/case-flow", "destination": "/case-flow.html" },
    { "source": "/case-list", "destination": "/case-list.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
